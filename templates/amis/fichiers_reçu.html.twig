{% extends 'base.html.twig' %}

{% block title %}Mes fichiers reçus{% endblock %}

{% block body %}
<div class="container-fluid">
    <h1 class="text-center text-primary mt-4 pt-4 fw-bold">
        Fichiers partagés avec moi
    </h1>
    
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 bg-white p-4 m-0 text-primary">
            <div class="table-responsive">
                <table class="table table-hover">
                    {% if fichiers_recus | length > 0 %}
                        {% for fichier in fichiers_recus %}
                            <tr>
                                <td class="text-center">
                                    <fieldset>
                                        <legend>
                                            <i class="bi bi-filetype-pdf"></i>
                                            {# Lien de téléchargement utilisant la même route que dans ton code précédent #}
                                            <a href="{{ path('app_telechargement_fichier_ami', {'id': fichier.id}) }}" style="text-decoration: none">
                                                {{ fichier.nomOriginal }}
                                            </a>
                                        </legend>
                                        
                                        <ul style="list-style: none">
                                            {% for s in fichier.scategories %}
                                                <li>{{ s.numero }} {{ s.libelle | capitalize }}</li>
                                            {% endfor %}
                                        </ul>

                                        {# Optionnel : Afficher qui a envoyé le fichier si ton entité Fichier possède un lien vers le propriétaire (ex: fichier.proprietaire) #}
                                        <div class="mt-2 text-muted small">
                                            <i class="bi bi-person-down"></i> Reçu de : 
                                            {% if fichier.user %}
                                                {{ fichier.user.prenom | capitalize }} {{ fichier.user.nom | upper }}
                                            {% else %}
                                                Un ami
                                            {% endif %}
                                        </div>
                                    </fieldset>
                                </td>
                            </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td class="text-center">Vous n'avez reçu aucun fichier pour le moment.</td>
                        </tr>
                    {% endif %}
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
{% extends 'base.html.twig' %}

{% block title %}
	{{parent()}}Liste des users
{% endblock %}
{% block body %}
	<div class="container-fluid">
		<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">
			Liste des users</h1>
		<div class="row justify-content-center">
			<div class="col-12 col-md-8 p-4 m-0 text-primary">
				<div class="table-responsive">
					<table class="table table-hover">
						<thead>
							<tr class="fw-bold text-primary">
								<th scope="col">Email</th>
								<th scope="col">Date d'inscirption</th>
								<th scope="col">Rôle</th>
								<th scope="col">Fichier</th>
							</tr>
						</thead>
						<tbody>
							{% for user in user |sort((a,b)=>b.dateEnvoi<=>a.dateEnvoi) %}
								<tr class="{{ cycle(['table-primary', 'table-secondary'], loop.index0) }}">
									<td>{{ user.email | lower }}</td>
									<td>{{ user.dateEnvoi |date("d-m-Y")}}</td>
									<td>
										{% if "ROLE_ADMIN" in user.roles %}
											Administrateur
										{% else %}
											{% if "ROLE_MOD" in user.roles %}
												Modérateur
											{% else %}
												Utilisateur
											{% endif %}
										{% endif %}
									</td>
									<td>{{ user.fichiers | length }}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
{% endblock %}

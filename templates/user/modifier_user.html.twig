{% extends 'base.html.twig' %}

{% block title %}
	{{parent()}}
	Modifier User
{% endblock %}

{% block body %}
<div class="container-fluid">
	<h1 class="text-center text-primary mt-4 pt-4 display-1 fw-bold">Modifier User</h1>
	<div class="row justify-content-center">
		<div class="col-12 col-md-6 bg-white p-4 m-0 text-primary">
            {{ form_start(ModifierUserForm) }}
			{{ form_row(ModifierUserForm.email) }}
			{{ form_row(ModifierUserForm.nom) }}
			{{ form_row(ModifierUserForm.prenom) }}
			{{ form_row(ModifierUserForm.adresse) }}
			{{ form_row(ModifierUserForm.ville) }}
			{{ form_row(ModifierUserForm.cp) }}
            <div class="text-center">
					<button class="btn btn-lg btn-primary mt-2" type="submit">modifier</button>
				</div>
			</div>
		</div>
	</div>
{% endblock %}
